<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- US-005, US-006: danh muc khoan thu, doi don gia, tao khoan tu nguyen. -->
<BorderPane xmlns:fx="http://javafx.com/fxml" styleClass="nen"
            fx:controller="com.bluemoon.controller.KhoanThuController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <top>
        <Label text="Khoản thu" styleClass="tieu-de-trang">
            <BorderPane.margin>
                <Insets bottom="12"/>
            </BorderPane.margin>
        </Label>
    </top>
    <center>
        <VBox styleClass="the" spacing="10">
            <TableView fx:id="bangKhoan" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_SUBSEQUENT_COLUMNS"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="cotTen" text="Tên khoản thu"
                                 prefWidth="220"/>
                    <TableColumn fx:id="cotLoai" text="Loại" prefWidth="100"/>
                    <TableColumn fx:id="cotMucThu" text="Mức thu"
                                 prefWidth="140"/>
                    <TableColumn fx:id="cotThoiGian" text="Thời gian"
                                 prefWidth="190"/>
                    <TableColumn fx:id="cotTrangThai" text="Trạng thái"
                                 prefWidth="100"/>
                </columns>
                <placeholder>
                    <Label text="Chưa có khoản thu nào"/>
                </placeholder>
            </TableView>
            <HBox fx:id="suaDonGiaBox" spacing="10">
                <Label fx:id="dangChonLabel" styleClass="phu-de"
                       wrapText="true"/>
                <Region HBox.hgrow="ALWAYS"/>
                <TextField fx:id="donGiaField" promptText="Đơn giá đ/m²"
                           prefWidth="140"/>
                <Button minWidth="-Infinity" text="Sửa đơn giá" onAction="#onSuaDonGia"/>
            </HBox>
        </VBox>
    </center>
    <right>
        <VBox fx:id="taoBox" styleClass="the" spacing="10" prefWidth="340">
            <BorderPane.margin>
                <Insets left="16"/>
            </BorderPane.margin>
            <Label text="Tạo khoản thu tự nguyện" styleClass="tieu-de-form"/>
            <Label text="Tên khoản thu *"/>
            <TextField fx:id="tenField" promptText="vd Quỹ khuyến học 2026"/>
            <HBox spacing="10">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Từ ngày *"/>
                    <DatePicker fx:id="tuNgayPicker"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Đến ngày *"/>
                    <DatePicker fx:id="denNgayPicker"/>
                </VBox>
            </HBox>
            <Label text="Số tiền mỗi hộ (không bắt buộc)"/>
            <TextField fx:id="soTienField"
                       promptText="Để trống nếu không cố định"/>
            <Label text="Tên khoản thu không được trùng trong cùng đợt."
                   styleClass="phu-de" wrapText="true"/>
            <Region VBox.vgrow="ALWAYS"/>
            <HBox spacing="10">
                <Button minWidth="-Infinity" text="Tạo khoản thu" styleClass="nut-chinh"
                        defaultButton="true" onAction="#onTao"/>
                <Button minWidth="-Infinity" text="Nhập mới" onAction="#onNhapMoi"/>
            </HBox>
        </VBox>
    </right>
    <bottom>
        <Label fx:id="thongBaoLabel" wrapText="true">
            <BorderPane.margin>
                <Insets top="10"/>
            </BorderPane.margin>
        </Label>
    </bottom>
</BorderPane>
