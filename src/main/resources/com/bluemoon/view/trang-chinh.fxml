<?xml version="1.0" encoding="UTF-8"?>

<?import com.bluemoon.controller.BieuDoThuPhi?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.bluemoon.controller.TrangChinhController">
    <top>
        <HBox styleClass="thanh-dau" spacing="12">
            <!-- Bam logo ve Trang chinh (khong co muc "Trang chu" rieng). -->
            <Button fx:id="logoButton" text="BlueMoon" styleClass="logo"
                    minWidth="-Infinity" onAction="#onVeTrangChu">
                    <!-- Con tro ban tay dat bang CSS (.thanh-dau .logo). -->
                <tooltip>
                    <Tooltip text="Về trang chủ"/>
                </tooltip>
            </Button>
            <Button minWidth="-Infinity" fx:id="hoGiaDinhButton" text="Hộ gia đình"
                    styleClass="nut-menu" onAction="#onMoHoGiaDinh"/>
            <Button minWidth="-Infinity" fx:id="nhanKhauButton" text="Nhân khẩu"
                    styleClass="nut-menu" onAction="#onMoNhanKhau"/>
            <Button minWidth="-Infinity" fx:id="khoanThuButton" text="Khoản thu" styleClass="nut-menu"
                    onAction="#onMoKhoanThu"/>
            <Button minWidth="-Infinity" fx:id="congNoButton" text="Công nợ" styleClass="nut-menu"
                    onAction="#onMoCongNo"/>
            <Button minWidth="-Infinity" fx:id="thuPhiButton" text="Thu phí" styleClass="nut-menu"
                    onAction="#onMoThuPhi"/>
            <Button minWidth="-Infinity" fx:id="thongKeButton" text="Thống kê" styleClass="nut-menu"
                    onAction="#onMoThongKe"/>
            <Button minWidth="-Infinity" fx:id="taiKhoanButton" text="Tài khoản" styleClass="nut-menu"
                    onAction="#onMoTaiKhoan"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="chaoLabel" styleClass="chao"/>
            <Button minWidth="-Infinity" text="Đăng xuất" onAction="#onDangXuat"/>
        </HBox>
    </top>
    <center>
        <StackPane fx:id="noiDung" styleClass="nen">
            <!-- US-016 theo frame "Trang chính – 1440x1024" (Figma). Cuộn
                 được khi cửa sổ thấp. -->
            <ScrollPane fitToWidth="true" styleClass="cuon-trang">
                <VBox spacing="20">
                    <padding>
                        <Insets top="28" right="40" bottom="28" left="40"/>
                    </padding>
                    <Label fx:id="tieuDeLabel" text="Tổng quan"
                           styleClass="tieu-de-trang"/>
                    <HBox fx:id="nhacChotBox" styleClass="the" spacing="16"
                          alignment="CENTER_LEFT"
                          visible="false" managed="false">
                        <Label fx:id="nhacChotLabel" HBox.hgrow="ALWAYS"
                               wrapText="true"/>
                        <Button text="Chốt công nợ" styleClass="nut-chinh"
                                minWidth="-Infinity" onAction="#onMoCongNo"/>
                    </HBox>
                    <HBox spacing="20">
                        <VBox styleClass="the, the-so" spacing="6"
                              minWidth="330">
                            <Label text="Đã thu tháng này"
                                   styleClass="phu-de"/>
                            <Label fx:id="daThuLabel" text="0 đ"
                                   styleClass="so-lon"/>
                            <Label fx:id="tyLeLabel" styleClass="phu-de"/>
                        </VBox>
                        <!-- US-017: bam the mo man Cong no, tab "Ho no dong". -->
                        <VBox fx:id="hoConNoBox" styleClass="the, the-so, the-bam"
                              spacing="6" minWidth="330"
                              onMouseClicked="#onMoNoDong">
                            <Label text="Hộ còn nợ" styleClass="phu-de"/>
                            <Label fx:id="soHoNoLabel" text="0"
                                   styleClass="so-lon"/>
                            <Label fx:id="noDongLabel" styleClass="phu-de"/>
                        </VBox>
                    </HBox>
                    <HBox spacing="20">
                        <VBox styleClass="the" spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="Thu phí 6 tháng gần nhất"
                                   styleClass="tieu-de-form"/>
                            <BieuDoThuPhi fx:id="bieuDo" prefHeight="420"
                                          minHeight="320"/>
                            <Label fx:id="chuThichLabel" styleClass="phu-de"
                                   wrapText="true"/>
                        </VBox>
                        <VBox fx:id="bienDongBox" styleClass="the"
                              spacing="10" prefWidth="460" minWidth="380"
                              visible="false" managed="false">
                            <Label text="Biến động nhân khẩu gần đây"
                                   styleClass="tieu-de-form"/>
                        </VBox>
                    </HBox>
                </VBox>
            </ScrollPane>
        </StackPane>
    </center>
</BorderPane>
