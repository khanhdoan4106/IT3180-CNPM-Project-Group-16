<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.bluemoon.controller.TrangChinhController">
    <top>
        <HBox styleClass="thanh-dau" spacing="12">
            <Label text="BlueMoon" styleClass="logo"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="chaoLabel" styleClass="chao"/>
            <Button text="Dang xuat" onAction="#onDangXuat"/>
        </HBox>
    </top>
    <center>
        <StackPane styleClass="nen">
            <Label text="Khung man hinh chinh - them chuc nang theo sprint"
                   styleClass="phu-de"/>
        </StackPane>
    </center>
</BorderPane>
