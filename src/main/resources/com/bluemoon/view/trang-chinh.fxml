<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.bluemoon.controller.TrangChinhController">
    <top>
        <HBox styleClass="thanh-dau" spacing="12">
            <Label text="BlueMoon" styleClass="logo" minWidth="-Infinity"/>
            <Button minWidth="-Infinity" fx:id="hoGiaDinhButton" text="Hộ gia đình"
                    styleClass="nut-menu" onAction="#onMoHoGiaDinh"/>
            <Button minWidth="-Infinity" fx:id="nhanKhauButton" text="Nhân khẩu"
                    styleClass="nut-menu" onAction="#onMoNhanKhau"/>
            <Button minWidth="-Infinity" text="Khoản thu" styleClass="nut-menu"
                    onAction="#onMoKhoanThu"/>
            <Button minWidth="-Infinity" text="Công nợ" styleClass="nut-menu"
                    onAction="#onMoCongNo"/>
            <Button minWidth="-Infinity" text="Tài khoản" styleClass="nut-menu"
                    onAction="#onMoTaiKhoan"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="chaoLabel" styleClass="chao"/>
            <Button minWidth="-Infinity" text="Đăng xuất" onAction="#onDangXuat"/>
        </HBox>
    </top>
    <center>
        <StackPane fx:id="noiDung" styleClass="nen">
            <VBox spacing="16" alignment="CENTER">
                <HBox fx:id="nhacChotBox" styleClass="the" spacing="16"
                      alignment="CENTER_LEFT" maxWidth="640"
                      visible="false" managed="false">
                    <Label fx:id="nhacChotLabel" HBox.hgrow="ALWAYS"
                           wrapText="true"/>
                    <Button text="Chốt công nợ" styleClass="nut-chinh"
                            minWidth="-Infinity" onAction="#onMoCongNo"/>
                </HBox>
                <VBox fx:id="bienDongBox" styleClass="the" spacing="10"
                      maxWidth="900" visible="false" managed="false">
                    <Label text="Biến động dân cư gần đây"
                           styleClass="tieu-de-form"/>
                </VBox>
                <Label text="Chọn chức năng trên thanh menu"
                       styleClass="phu-de"/>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
