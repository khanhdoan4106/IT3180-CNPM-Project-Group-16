<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- US-020: Dang ky tai khoan. Chi Quan tri vien mo duoc man hinh nay. -->
<BorderPane xmlns:fx="http://javafx.com/fxml" styleClass="nen"
            fx:controller="com.bluemoon.controller.TaiKhoanController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <top>
        <Label text="Đăng ký tài khoản" styleClass="tieu-de-trang">
            <BorderPane.margin>
                <Insets bottom="12"/>
            </BorderPane.margin>
        </Label>
    </top>
    <left>
        <VBox styleClass="the" spacing="10" prefWidth="420"
              maxHeight="-Infinity">
            <GridPane hgap="10" vgap="10">
                <columnConstraints>
                    <ColumnConstraints minWidth="130"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>
                <Label text="Tên đăng nhập *" GridPane.rowIndex="0"/>
                <TextField fx:id="tenDangNhapField" promptText="vd ketoan01"
                           GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Label text="Họ tên *" GridPane.rowIndex="1"/>
                <TextField fx:id="hoTenField"
                           GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                <Label text="Mật khẩu *" GridPane.rowIndex="2"/>
                <PasswordField fx:id="matKhauField"
                               promptText="ít nhất 8 ký tự"
                               GridPane.rowIndex="2"
                               GridPane.columnIndex="1"/>
                <Label text="Nhập lại mật khẩu *" GridPane.rowIndex="3"/>
                <PasswordField fx:id="nhapLaiField"
                               GridPane.rowIndex="3"
                               GridPane.columnIndex="1"/>
                <Label text="Vai trò *" GridPane.rowIndex="4"/>
                <ComboBox fx:id="vaiTroCombo" maxWidth="Infinity"
                          GridPane.rowIndex="4" GridPane.columnIndex="1"/>
            </GridPane>
            <Label fx:id="thongBaoLabel" wrapText="true"/>
            <HBox spacing="10">
                <Button text="Đăng ký" defaultButton="true"
                        styleClass="nut-chinh" onAction="#onDangKy"/>
                <Button text="Nhập mới" onAction="#onNhapMoi"/>
            </HBox>
        </VBox>
    </left>
</BorderPane>
