<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- US-010 - US-014 thu phi, in bien lai, huy phieu; US-007 dong gop. -->
<BorderPane xmlns:fx="http://javafx.com/fxml" styleClass="nen"
            fx:controller="com.bluemoon.controller.ThuPhiController">
    <fx:define>
        <ToggleGroup fx:id="hinhThucGroup"/>
    </fx:define>
    <padding>
        <Insets top="16" right="20" bottom="16" left="20"/>
    </padding>
    <center>
        <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE">
            <Tab fx:id="thuTab" text="Thu tiền">
                <BorderPane>
                    <padding>
                        <Insets top="12" right="4" bottom="0" left="4"/>
                    </padding>
                    <top>
                        <VBox spacing="8">
                            <BorderPane.margin>
                                <Insets bottom="10"/>
                            </BorderPane.margin>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="Mã phòng" minWidth="-Infinity"/>
                                <TextField fx:id="maField" prefWidth="140"
                                           promptText="vd A0601"
                                           onAction="#onTraCuu"/>
                                <Button minWidth="-Infinity" text="Tra cứu"
                                        onAction="#onTraCuu"/>
                                <ComboBox fx:id="hoCombo" prefWidth="320"
                                          visible="false" managed="false"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="lichSuButton" minWidth="-Infinity"
                                        text="Lịch sử thu của hộ"
                                        disable="true" onAction="#onLichSu"/>
                            </HBox>
                            <Label fx:id="hoLabel" styleClass="tieu-de-form"
                                   wrapText="true"
                                   text="Nhập mã phòng rồi bấm Tra cứu"/>
                        </VBox>
                    </top>
                    <center>
                        <HBox spacing="16">
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="Khoản phải nộp chưa đóng"
                                       styleClass="tieu-de-form"/>
                                <TableView fx:id="bangNo" editable="true"
                                           VBox.vgrow="ALWAYS">
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_SUBSEQUENT_COLUMNS"/>
                                    </columnResizePolicy>
                                    <columns>
                                        <TableColumn fx:id="cotChon" text="Thu"
                                                     prefWidth="50"
                                                     sortable="false"/>
                                        <TableColumn fx:id="cotThang"
                                                     text="Tháng"
                                                     prefWidth="90"/>
                                        <TableColumn fx:id="cotKhoan"
                                                     text="Khoản"
                                                     prefWidth="220"/>
                                        <TableColumn fx:id="cotSoTien"
                                                     text="Số tiền"
                                                     prefWidth="130"/>
                                    </columns>
                                    <placeholder>
                                        <Label text="Không có khoản chưa đóng"/>
                                    </placeholder>
                                </TableView>
                                <HBox spacing="8">
                                    <Button minWidth="-Infinity"
                                            text="Chọn tất cả"
                                            onAction="#onChonTatCa"/>
                                    <Button minWidth="-Infinity"
                                            text="Bỏ chọn tất cả"
                                            onAction="#onBoChonTatCa"/>
                                </HBox>
                            </VBox>
                            <VBox spacing="6" prefWidth="420" minWidth="380">
                                <Label text="Đóng góp tự nguyện"
                                       styleClass="tieu-de-form"/>
                                <Label styleClass="phu-de" wrapText="true"
                                       text="Để trống nếu chưa thu. Nhập 0 nếu hộ không đóng."/>
                                <ScrollPane fitToWidth="true"
                                            styleClass="cuon-form"
                                            VBox.vgrow="ALWAYS">
                                    <GridPane fx:id="quyGrid" hgap="10"
                                              vgap="8">
                                        <padding>
                                            <Insets top="4" right="8"
                                                    bottom="4" left="2"/>
                                        </padding>
                                    </GridPane>
                                </ScrollPane>
                            </VBox>
                        </HBox>
                    </center>
                    <bottom>
                        <VBox spacing="6">
                            <BorderPane.margin>
                                <Insets top="10"/>
                            </BorderPane.margin>
                            <HBox spacing="14" alignment="CENTER_LEFT">
                                <Label text="Hình thức" minWidth="-Infinity"/>
                                <RadioButton fx:id="tienMatRadio"
                                             minWidth="-Infinity"
                                             text="Tiền mặt"
                                             toggleGroup="$hinhThucGroup"/>
                                <RadioButton fx:id="chuyenKhoanRadio"
                                             minWidth="-Infinity"
                                             text="Chuyển khoản"
                                             toggleGroup="$hinhThucGroup"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="tongLabel" styleClass="tong-thu"
                                       minWidth="-Infinity"
                                       text="Tổng thu: 0 đ"/>
                                <Button fx:id="thuButton" minWidth="-Infinity"
                                        text="Thu các khoản đã chọn"
                                        styleClass="nut-chinh"
                                        disable="true" onAction="#onThu"/>
                            </HBox>
                            <Label fx:id="thongBaoLabel" wrapText="true"/>
                        </VBox>
                    </bottom>
                </BorderPane>
            </Tab>
            <Tab fx:id="phieuTab" text="Phiếu thu hôm nay">
                <BorderPane>
                    <padding>
                        <Insets top="12" right="4" bottom="0" left="4"/>
                    </padding>
                    <center>
                        <TableView fx:id="bangPhieu">
                            <placeholder>
                                <Label text="Hôm nay chưa có phiếu thu"/>
                            </placeholder>
                        </TableView>
                    </center>
                    <bottom>
                        <VBox spacing="6">
                            <BorderPane.margin>
                                <Insets top="10"/>
                            </BorderPane.margin>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label styleClass="phu-de" wrapText="true"
                                       HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                       text="Chỉ hủy được phiếu lập trong ngày. Phiếu đã hủy vẫn được lưu."/>
                                <Button minWidth="-Infinity" text="Làm mới"
                                        onAction="#onLamMoiPhieu"/>
                                <Button minWidth="-Infinity" text="Xem chi tiết"
                                        onAction="#onXemChiTiet"/>
                                <Button minWidth="-Infinity" text="In biên lai"
                                        onAction="#onInBienLai"/>
                                <Button minWidth="-Infinity" text="Hủy phiếu"
                                        styleClass="nut-phu"
                                        onAction="#onHuyPhieu"/>
                            </HBox>
                            <Label fx:id="thongBaoPhieuLabel" wrapText="true"/>
                        </VBox>
                    </bottom>
                </BorderPane>
            </Tab>
        </TabPane>
    </center>
</BorderPane>
