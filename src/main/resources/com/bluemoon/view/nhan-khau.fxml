<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- US-002: Quan ly nhan khau. Tren: chon ho; trai: thanh vien; phai: form.
     Danh sach ho chi gom ho dang o. -->
<BorderPane xmlns:fx="http://javafx.com/fxml" styleClass="nen"
            fx:controller="com.bluemoon.controller.NhanKhauController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <top>
        <VBox spacing="12">
            <Label text="Quan ly nhan khau" styleClass="tieu-de-trang"/>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="Ho gia dinh"/>
                <ComboBox fx:id="hoCombo" prefWidth="320"
                          promptText="Chon ho dang o"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="soThanhVienLabel" styleClass="phu-de"/>
            </HBox>
            <BorderPane.margin>
                <Insets bottom="12"/>
            </BorderPane.margin>
        </VBox>
    </top>
    <center>
        <TableView fx:id="bangNhanKhau">
            <columns>
                <TableColumn fx:id="cotHoTen" text="Ho ten" prefWidth="220"/>
                <TableColumn fx:id="cotNgaySinh" text="Ngay sinh"
                             prefWidth="110"/>
                <TableColumn fx:id="cotGioiTinh" text="Gioi tinh"
                             prefWidth="90"/>
                <TableColumn fx:id="cotCccd" text="So CCCD" prefWidth="140"/>
                <TableColumn fx:id="cotQuanHe" text="Quan he voi chu ho"
                             prefWidth="150"/>
            </columns>
            <placeholder>
                <Label text="Chon mot ho de xem thanh vien"/>
            </placeholder>
        </TableView>
    </center>
    <right>
        <VBox styleClass="the" spacing="10" prefWidth="380">
            <BorderPane.margin>
                <Insets left="20"/>
            </BorderPane.margin>
            <Label fx:id="tieuDeFormLabel" text="Them nhan khau"
                   styleClass="tieu-de-form"/>
            <GridPane hgap="10" vgap="10">
                <columnConstraints>
                    <ColumnConstraints minWidth="120"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>
                <Label text="Ho ten *" GridPane.rowIndex="0"/>
                <TextField fx:id="hoTenField" GridPane.rowIndex="0"
                           GridPane.columnIndex="1"/>
                <Label text="Ngay sinh *" GridPane.rowIndex="1"/>
                <DatePicker fx:id="ngaySinhPicker" maxWidth="Infinity"
                            GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                <Label text="Gioi tinh *" GridPane.rowIndex="2"/>
                <ComboBox fx:id="gioiTinhCombo" maxWidth="Infinity"
                          GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                <Label text="So CCCD" GridPane.rowIndex="3"/>
                <TextField fx:id="cccdField" promptText="12 chu so"
                           GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                <Label text="Quan he *" GridPane.rowIndex="4"/>
                <ComboBox fx:id="quanHeCombo" maxWidth="Infinity"
                          GridPane.rowIndex="4" GridPane.columnIndex="1"/>
            </GridPane>
            <Label fx:id="thongBaoLabel" wrapText="true"/>
            <HBox spacing="10">
                <Button fx:id="luuButton" text="Luu" defaultButton="true"
                        styleClass="nut-chinh" onAction="#onLuu"/>
                <Button text="Nhap moi" onAction="#onNhapMoi"/>
            </HBox>
        </VBox>
    </right>
</BorderPane>
