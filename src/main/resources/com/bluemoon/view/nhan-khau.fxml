<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- US-002, US-003: Quan ly nhan khau. Tren: chon ho; giua: thanh vien va
     cac dot tam tru/tam vang cua nguoi dang chon; phai: form nhan khau.
     Danh sach ho chi gom ho dang o. -->
<BorderPane xmlns:fx="http://javafx.com/fxml" styleClass="nen"
            fx:controller="com.bluemoon.controller.NhanKhauController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <top>
        <VBox spacing="12">
            <Label text="Quản lý nhân khẩu" styleClass="tieu-de-trang"/>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="Hộ gia đình"/>
                <ComboBox fx:id="hoCombo" prefWidth="320"
                          promptText="Chọn hộ đang ở"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="soThanhVienLabel" styleClass="phu-de"/>
                <Button minWidth="-Infinity" fx:id="tamVangButton"
                        text="Xem danh sách tạm vắng"
                        onAction="#onDanhSachTamVang"/>
            </HBox>
            <BorderPane.margin>
                <Insets bottom="12"/>
            </BorderPane.margin>
        </VBox>
    </top>
    <center>
        <VBox spacing="16">
            <TableView fx:id="bangNhanKhau" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="cotHoTen" text="Họ tên"
                                 prefWidth="180"/>
                    <TableColumn fx:id="cotNgaySinh" text="Ngày sinh"
                                 prefWidth="115"/>
                    <TableColumn fx:id="cotGioiTinh" text="Giới tính"
                                 prefWidth="105"/>
                    <TableColumn fx:id="cotCccd" text="Số CCCD"
                                 prefWidth="125"/>
                    <TableColumn fx:id="cotQuanHe" text="Quan hệ"
                                 prefWidth="100"/>
                    <TableColumn fx:id="cotCuTru" text="Cư trú"
                                 prefWidth="95"/>
                    <TableColumn fx:id="cotHanTamTru" text="Hạn tạm trú"
                                 prefWidth="125"/>
                    <TableColumn fx:id="cotTamVang" text="Tạm vắng đến"
                                 prefWidth="140"/>
                    <TableColumn fx:id="cotTrangThai" text="Trạng thái"
                                 prefWidth="120"/>
                </columns>
                <placeholder>
                    <Label text="Chọn một hộ để xem thành viên"/>
                </placeholder>
            </TableView>
            <!-- US-003: cac dot cua nguoi dang chon va form ghi dot moi. -->
            <VBox styleClass="the" spacing="10">
                <Label fx:id="tieuDeDotLabel" text="Tạm trú / tạm vắng"
                       styleClass="tieu-de-form"/>
                <HBox spacing="16">
                    <TableView fx:id="bangDot" prefHeight="170"
                               HBox.hgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="cotDotLoai" text="Loại"
                                         prefWidth="85"/>
                            <TableColumn fx:id="cotDotTu" text="Từ ngày"
                                         prefWidth="110"/>
                            <TableColumn fx:id="cotDotDen" text="Đến ngày"
                                         prefWidth="115"/>
                            <TableColumn fx:id="cotDotLyDo" text="Lý do"
                                         prefWidth="180"/>
                        </columns>
                        <placeholder>
                            <Label text="Chưa có đợt nào"/>
                        </placeholder>
                    </TableView>
                    <VBox fx:id="dotForm" spacing="8" prefWidth="330">
                        <!-- Enter trong khung nay chi chay "Ghi nhan" (PhimEnter). -->
                        <properties enterChay="ghiDotButton"/>
                        <GridPane hgap="10" vgap="8">
                            <columnConstraints>
                                <ColumnConstraints minWidth="-Infinity"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>
                            <Label text="Loại *" GridPane.rowIndex="0"/>
                            <ComboBox fx:id="loaiDotCombo" minWidth="120"
                                      maxWidth="Infinity"
                                      GridPane.rowIndex="0"
                                      GridPane.columnIndex="1"/>
                            <Label text="Từ ngày *" GridPane.rowIndex="1"/>
                            <DatePicker fx:id="dotTuPicker" minWidth="120"
                                        maxWidth="Infinity"
                                        GridPane.rowIndex="1"
                                        GridPane.columnIndex="1"/>
                            <Label text="Đến ngày *" GridPane.rowIndex="2"/>
                            <DatePicker fx:id="dotDenPicker" minWidth="120"
                                        maxWidth="Infinity"
                                        GridPane.rowIndex="2"
                                        GridPane.columnIndex="1"/>
                            <Label text="Lý do" GridPane.rowIndex="3"/>
                            <TextField fx:id="lyDoField" GridPane.rowIndex="3"
                                       GridPane.columnIndex="1"/>
                        </GridPane>
                        <Label fx:id="thongBaoDotLabel" wrapText="true"/>
                        <Button minWidth="-Infinity" fx:id="ghiDotButton" text="Ghi nhận"
                                styleClass="nut-chinh" disable="true"
                                onAction="#onGhiDot"/>
                    </VBox>
                </HBox>
            </VBox>
        </VBox>
    </center>
    <right>
        <!-- Cua so thap (1120x645) khong du cao cho ca form: cuon duoc de
             toi cac nut. Khung trang dat tren ScrollPane de bong khong bi
             cat. -->
        <!-- Cot nhan moi GridPane trong form rong co dinh 116px (nhan dai
             nhat "Nơi thường trú *" voi Be Vietnam Pro ~108px) de o nhap
             cac nhom thang hang. Doi nhan thi do lai. -->
        <ScrollPane styleClass="the,cuon-form" fitToWidth="true"
                    hbarPolicy="NEVER" prefWidth="430">
            <BorderPane.margin>
                <Insets left="20"/>
            </BorderPane.margin>
            <VBox fx:id="nhanKhauForm" spacing="10">
                <!-- Enter trong khung nay chi chay "Luu" (PhimEnter). -->
                <properties enterChay="luuButton"/>
                <Label fx:id="tieuDeFormLabel" text="Thêm nhân khẩu"
                       styleClass="tieu-de-form"/>
                <GridPane hgap="10" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints minWidth="140" prefWidth="140" maxWidth="140"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    <Label text="Họ tên *" GridPane.rowIndex="0"/>
                    <TextField fx:id="hoTenField" GridPane.rowIndex="0"
                               GridPane.columnIndex="1"/>
                    <Label text="Ngày sinh *" GridPane.rowIndex="1"/>
                    <DatePicker fx:id="ngaySinhPicker" minWidth="120" maxWidth="Infinity"
                                GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    <Label text="Giới tính *" GridPane.rowIndex="2"/>
                    <ComboBox fx:id="gioiTinhCombo" minWidth="120" maxWidth="Infinity"
                              GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                    <Label text="Số CCCD" GridPane.rowIndex="3"/>
                    <TextField fx:id="cccdField"
                               promptText="12 chữ số"
                               GridPane.rowIndex="3" GridPane.columnIndex="1">
                        <tooltip>
                            <Tooltip text="Số CCCD gồm 12 chữ số, bắt buộc với người từ đủ 14 tuổi"/>
                        </tooltip>
                    </TextField>
                    <Label text="Quan hệ *" GridPane.rowIndex="4"/>
                    <ComboBox fx:id="quanHeCombo" minWidth="120" maxWidth="Infinity"
                              GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                    <Label text="Cư trú *" GridPane.rowIndex="5"/>
                    <ComboBox fx:id="loaiCuTruCombo" minWidth="120" maxWidth="Infinity"
                              GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                </GridPane>
                <!-- Chi hien voi nguoi tam tru; ngay tam tru chi khi them moi. -->
                <GridPane fx:id="tamTruGrid" hgap="10" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints minWidth="140" prefWidth="140" maxWidth="140"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    <Label text="Nơi thường trú *" GridPane.rowIndex="0"/>
                    <TextField fx:id="noiThuongTruField" GridPane.rowIndex="0"
                               GridPane.columnIndex="1"/>
                    <Label fx:id="tamTruTuLabel" text="Tạm trú từ *"
                           GridPane.rowIndex="1"/>
                    <DatePicker fx:id="tamTruTuPicker" minWidth="120" maxWidth="Infinity"
                                GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    <Label fx:id="tamTruDenLabel" text="Tạm trú đến *"
                           GridPane.rowIndex="2"/>
                    <DatePicker fx:id="tamTruDenPicker" minWidth="120" maxWidth="Infinity"
                                GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                </GridPane>
                <Label fx:id="thongBaoLabel" wrapText="true"/>
                <!-- Hai hang: khung form khong du cho 4 nut tren mot hang;
                     hang duoi xuong dong khi chu 16 px khong du cho. -->
                <HBox spacing="10">
                    <Button minWidth="-Infinity" fx:id="luuButton" text="Lưu"
                            styleClass="nut-chinh" onAction="#onLuu"/>
                    <Button minWidth="-Infinity" text="Nhập mới" onAction="#onNhapMoi"/>
                </HBox>
                <FlowPane hgap="10" vgap="10" prefWrapLength="300">
                    <Button minWidth="-Infinity" fx:id="chuHoButton" text="Đặt làm chủ hộ"
                            disable="true" onAction="#onDatChuHo"/>
                    <Button minWidth="-Infinity" fx:id="chuyenDiButton" text="Đánh dấu chuyển đi"
                            styleClass="nut-nguy-hiem" disable="true"
                            onAction="#onChuyenDi"/>
                </FlowPane>
            </VBox>
        </ScrollPane>
    </right>
</BorderPane>
