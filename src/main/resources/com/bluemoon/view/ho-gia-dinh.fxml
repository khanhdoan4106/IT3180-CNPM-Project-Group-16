<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- US-001: Quan ly ho gia dinh. Trai: danh sach + tim kiem; phai: form. -->
<BorderPane xmlns:fx="http://javafx.com/fxml" styleClass="nen"
            fx:controller="com.bluemoon.controller.HoGiaDinhController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <top>
        <VBox spacing="12">
            <Label text="Quản lý hộ gia đình" styleClass="tieu-de-trang"/>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <TextField fx:id="timKiemField" prefWidth="320"
                           promptText="Tìm theo mã căn hộ hoặc tên chủ hộ"/>
                <CheckBox fx:id="gomChuyenDiCheck"
                          text="Hiện cả hộ đã chuyển đi"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="soLuongLabel" styleClass="phu-de"/>
            </HBox>
            <BorderPane.margin>
                <Insets bottom="12"/>
            </BorderPane.margin>
        </VBox>
    </top>
    <center>
        <TableView fx:id="bangHo">
            <columns>
                <TableColumn fx:id="cotMa" text="Mã căn hộ" prefWidth="100"/>
                <TableColumn fx:id="cotLoai" text="Loại" prefWidth="90"/>
                <TableColumn fx:id="cotTang" text="Tầng" prefWidth="60"/>
                <TableColumn fx:id="cotDienTich" text="Diện tích (m²)"
                             prefWidth="110"/>
                <TableColumn fx:id="cotChuHo" text="Chủ hộ" prefWidth="200"/>
                <TableColumn fx:id="cotSoThanhVien" text="Thành viên"
                             prefWidth="90"/>
                <TableColumn fx:id="cotSdt" text="Điện thoại"
                             prefWidth="120"/>
                <TableColumn fx:id="cotNgay" text="Ngày chuyển đến"
                             prefWidth="130"/>
                <TableColumn fx:id="cotTrangThai" text="Trạng thái"
                             prefWidth="110"/>
            </columns>
            <placeholder>
                <Label text="Chưa có hộ gia đình nào"/>
            </placeholder>
        </TableView>
    </center>
    <right>
        <VBox styleClass="the" spacing="10" prefWidth="380">
            <BorderPane.margin>
                <Insets left="20"/>
            </BorderPane.margin>
            <Label fx:id="tieuDeFormLabel" text="Thêm hộ gia đình"
                   styleClass="tieu-de-form"/>
            <GridPane hgap="10" vgap="10">
                <columnConstraints>
                    <ColumnConstraints minWidth="120"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>
                <Label text="Mã căn hộ *" GridPane.rowIndex="0"/>
                <TextField fx:id="maField" promptText="vd A0601"
                           GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Label text="Loại căn hộ *" GridPane.rowIndex="1"/>
                <ComboBox fx:id="loaiCombo" maxWidth="Infinity"
                          GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                <Label text="Tầng *" GridPane.rowIndex="2"/>
                <TextField fx:id="tangField" promptText="1 - 30"
                           GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                <Label text="Diện tích (m²) *" GridPane.rowIndex="3"/>
                <TextField fx:id="dienTichField" promptText="vd 75.5"
                           GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                <Label text="Số điện thoại" GridPane.rowIndex="4"/>
                <TextField fx:id="sdtField" promptText="10 chữ số"
                           GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                <Label text="Ngày chuyển đến *" GridPane.rowIndex="5"/>
                <DatePicker fx:id="ngayPicker" maxWidth="Infinity"
                            GridPane.rowIndex="5" GridPane.columnIndex="1"/>
            </GridPane>
            <!-- Them moi: nhap chu ho (US-002). Sua: chi hien chuHoLabel. -->
            <VBox fx:id="chuHoBox" spacing="10">
                <Label text="Chủ hộ" styleClass="tieu-de-form"/>
                <GridPane hgap="10" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints minWidth="120"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    <Label text="Họ tên *" GridPane.rowIndex="0"/>
                    <TextField fx:id="chuHoField" GridPane.rowIndex="0"
                               GridPane.columnIndex="1"/>
                    <Label text="Ngày sinh *" GridPane.rowIndex="1"/>
                    <DatePicker fx:id="ngaySinhChuHoPicker"
                                maxWidth="Infinity" GridPane.rowIndex="1"
                                GridPane.columnIndex="1"/>
                    <Label text="Giới tính *" GridPane.rowIndex="2"/>
                    <ComboBox fx:id="gioiTinhChuHoCombo" maxWidth="Infinity"
                              GridPane.rowIndex="2"
                              GridPane.columnIndex="1"/>
                    <Label text="Số CCCD" GridPane.rowIndex="3"/>
                    <TextField fx:id="cccdChuHoField"
                               promptText="bắt buộc từ 14 tuổi"
                               GridPane.rowIndex="3"
                               GridPane.columnIndex="1"/>
                    <Label text="Cư trú *" GridPane.rowIndex="4"/>
                    <ComboBox fx:id="loaiCuTruChuHoCombo"
                              maxWidth="Infinity" GridPane.rowIndex="4"
                              GridPane.columnIndex="1"/>
                </GridPane>
                <!-- US-003: chu ho tam tru (ho thue nha), kem dot dau. -->
                <GridPane fx:id="tamTruChuHoGrid" hgap="10" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints minWidth="120"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    <Label text="Nơi thường trú *" GridPane.rowIndex="0"/>
                    <TextField fx:id="noiThuongTruChuHoField"
                               GridPane.rowIndex="0"
                               GridPane.columnIndex="1"/>
                    <Label text="Tạm trú từ *" GridPane.rowIndex="1"/>
                    <DatePicker fx:id="tamTruTuChuHoPicker"
                                maxWidth="Infinity" GridPane.rowIndex="1"
                                GridPane.columnIndex="1"/>
                    <Label text="Tạm trú đến *" GridPane.rowIndex="2"/>
                    <DatePicker fx:id="tamTruDenChuHoPicker"
                                maxWidth="Infinity" GridPane.rowIndex="2"
                                GridPane.columnIndex="1"/>
                </GridPane>
            </VBox>
            <Label fx:id="chuHoLabel" wrapText="true" styleClass="phu-de"/>
            <Label fx:id="thongBaoLabel" wrapText="true"/>
            <HBox spacing="10">
                <Button fx:id="luuButton" text="Lưu" defaultButton="true"
                        styleClass="nut-chinh" onAction="#onLuu"/>
                <Button text="Nhập mới" onAction="#onNhapMoi"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="chuyenDiButton" text="Đánh dấu chuyển đi"
                        styleClass="nut-phu" disable="true"
                        onAction="#onChuyenDi"/>
            </HBox>
        </VBox>
    </right>
</BorderPane>
