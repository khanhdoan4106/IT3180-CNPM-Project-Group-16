<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- US-009 chot cong no dau thang, US-008 sua khoan phai nop cua ho. -->
<BorderPane xmlns:fx="http://javafx.com/fxml" styleClass="nen"
            fx:controller="com.bluemoon.controller.CongNoController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <top>
        <VBox spacing="10">
            <HBox spacing="10">
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Label text="Chốt công nợ đầu tháng"
                           styleClass="tieu-de-trang"/>
                    <Label text="Tạo khoản phải nộp phí dịch vụ và phí quản lý cho mọi hộ đang ở." wrapText="true"
                           styleClass="phu-de"/>
                </VBox>
                <ComboBox fx:id="thangCombo" prefWidth="160"/>
                <Button minWidth="-Infinity" text="Xem trước" onAction="#onXemTruoc"/>
            </HBox>
            <Label fx:id="trangThaiLabel" wrapText="true"/>
            <Label fx:id="boQuaLabel" styleClass="loi" wrapText="true"/>
            <Label fx:id="tomTatLabel"/>
            <BorderPane.margin>
                <Insets bottom="10"/>
            </BorderPane.margin>
        </VBox>
    </top>
    <center>
        <TableView fx:id="bangKhoan">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="cotCanHo" text="Căn hộ" prefWidth="110"/>
                <TableColumn fx:id="cotKhoan" text="Khoản" prefWidth="140"/>
                <TableColumn fx:id="cotDienTich" text="Diện tích"
                             prefWidth="100"/>
                <TableColumn fx:id="cotDonGia" text="Đơn giá" prefWidth="110"/>
                <TableColumn fx:id="cotSoTien" text="Phải nộp"
                             prefWidth="130"/>
                <TableColumn fx:id="cotGhiChu" text="Ghi chú" prefWidth="220"/>
            </columns>
            <placeholder>
                <Label text="Chọn tháng rồi bấm Xem trước"/>
            </placeholder>
        </TableView>
    </center>
    <bottom>
        <VBox spacing="8">
            <BorderPane.margin>
                <Insets top="10"/>
            </BorderPane.margin>
            <Label fx:id="thongBaoLabel" wrapText="true"/>
            <HBox spacing="10">
                <Label text="Sau khi chốt, có thể sửa khoản của từng hộ khi hộ chưa đóng tiền." wrapText="true"
                       styleClass="phu-de"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button minWidth="-Infinity" fx:id="suaButton" text="Sửa khoản đã chọn"
                        onAction="#onSua"/>
                <Button minWidth="-Infinity" text="Chốt công nợ"
                        styleClass="nut-chinh" onAction="#onChot"/>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
